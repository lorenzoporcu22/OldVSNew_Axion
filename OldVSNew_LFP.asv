lfpBandResults_new  = computeLfpBandPowers_v2(lfpPSD_new);
lfpBandResults_old1 = computeLfpBandPowers_v2(lfpPSD_old1);
lfpBandResults_old2 = computeLfpBandPowers_v2(lfpPSD_old2);